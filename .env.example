PORT=4000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Nexiva
JWT_SECRET=your_jwt_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Brevo (Email)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your@email.com
BREVO_SENDER_NAME=NEXIVA

NODE_ENV=production

# Frontend URLs (deployed URLs)
FRONTEND_URL=https://your-admin-dashboard.vercel.app
PATIENT_FRONTEND_URL=https://your-patient-dashboard.vercel.app

# Admin Credentials
ADMIN_EMAIL=admin@nexiva.com
ADMIN_PASSWORD=your_secure_password

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Groq AI
GROQ_API_KEY=your_groq_api_key
